{
  "name": "todos-service-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/todos-service-tests",
  "tags": ["scope:backend", "type:test", "lang:python"],
  "implicitDependencies": ["todos-service"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=../../backend/apps/todos-service:../../libs:../../libs/events:../../libs/context-service python -m pytest unit/ integration/ -v --cov=../../backend/apps/todos-service/app --cov-report=term-missing",
        "cwd": "tests/todos-service-tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m ruff check unit/ integration/",
        "cwd": "tests/todos-service-tests"
      }
    }
  }
}
