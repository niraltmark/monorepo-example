{
  "name": "users-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/users-service",
  "tags": ["scope:backend", "type:service", "lang:python"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
        "cwd": "apps/users-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m ruff check app/",
        "cwd": "apps/users-service"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t users-service:latest .",
        "cwd": "apps/users-service"
      }
    }
  }
}
