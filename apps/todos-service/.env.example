# Copy this file to .env and fill in the values

APP_NAME="Todos Service"
APP_VERSION="1.0.0"
DEBUG=false

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/todos_db

# URL of the users-service for cross-service calls (no FK, HTTP only)
USERS_SERVICE_URL=http://localhost:8001

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
