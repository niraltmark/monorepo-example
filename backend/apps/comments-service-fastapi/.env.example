# Copy to .env and fill in values

APP_NAME="Comments Service (FastAPI)"
APP_VERSION="1.0.0"
DEBUG=false

# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/comments_fastapi_db

# SQLite (local dev)
# DATABASE_URL=sqlite+aiosqlite:///./comments.db

USERS_SERVICE_URL=http://localhost:8001
TODOS_SERVICE_URL=http://localhost:8002
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
