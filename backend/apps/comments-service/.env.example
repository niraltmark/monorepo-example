# Copy this file to .env and fill in the values

DEBUG=false
SECRET_KEY=change-me-in-production-use-a-long-random-string

# PostgreSQL (production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comments_db

# SQLite (local dev)
# DATABASE_URL=sqlite:///./comments.db

ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URLs of sibling services (no FK — HTTP calls only)
USERS_SERVICE_URL=http://localhost:8001
TODOS_SERVICE_URL=http://localhost:8002
